import { Ionicons } from '@expo/vector-icons';
import AsyncStorage from '@react-native-async-storage/async-storage';
import * as FileSystem from 'expo-file-system';
import * as Haptics from 'expo-haptics';
import * as ImagePicker from 'expo-image-picker';
import { LinearGradient } from 'expo-linear-gradient';
import { useEffect, useRef, useState } from 'react';
import {
  Animated, BackHandler, Dimensions,
  Image,
  Modal,
  PanResponder,
  Platform,
  SafeAreaView,
  ScrollView,
  StyleSheet,
  Switch,
  Text,
  TextInput,
  TouchableOpacity,
  View
} from 'react-native';

const STORAGE_KEY_ONBOARDING = '@seedius_has_completed_onboarding';
const STORAGE_KEY_USERNAME = '@seedius_username';
const STORAGE_KEY_THEME = '@seedius_theme_dark';
const STORAGE_KEY_PRODUCTS = '@seedius_products';
const STORAGE_KEY_CATEGORIES = '@seedius_categories';
const STORAGE_KEY_NOTES = '@seedius_notes_list';
const STORAGE_KEY_HISTORY = '@seedius_daily_history';
const STORAGE_KEY_MONEY = '@seedius_total_money';
const STORAGE_KEY_PROFILE_IMG = '@seedius_profile_image';
const STORAGE_KEY_HOURS = '@seedius_hours_of_day';

export default function App() {
  const [hasCompletedOnboarding, setHasCompletedOnboarding] = useState(false);
  const [onboardingStep, setOnboardingStep] = useState(1);
  const [setupUsername, setSetupUsername] = useState('Administrador');
  const [setupThemeDark, setSetupThemeDark] = useState(true);
  const [acceptedTerms, setAcceptedTerms] = useState(false);

  // Estados del Tour Guiado
  const [isTourActive, setIsTourActive] = useState(false);
  const [tourStepIndex, setTourStepIndex] = useState(0);

  const tourSteps = [
    {
      tab: 'home',
      title: 'Panel Principal & Métricas',
      desc: 'Aquí visualizas el rendimiento global de ventas en tiempo real con las velas horarias y alertas de estoc.'
    },
    {
      tab: 'stock',
      title: 'Inventario y Catálogo',
      desc: 'Controla tus productos, añade nuevos elementos o edita categorías y precios con un toque o pulsación larga.'
    },
    {
      tab: 'notes',
      title: 'Bloc de Notas',
      desc: 'Anota recordatorios importantes o apuntes rápidos del negocio organizados de forma segura.'
    },
    {
      tab: 'profile',
      title: 'Ajustes y Respaldo',
      desc: 'Gestiona tu perfil, cambia entre Tema Oscuro/Claro y elimina o reinicia el historial completo de la app.'
    }
  ];

  const [isLoading, setIsLoading] = useState(true);
  const [currentTab, setCurrentTab] = useState<'home' | 'stock' | 'notes' | 'profile' | 'sell' | 'lowStock' | 'fullHistory'>('home');
  
  const [isDarkMode, setIsDarkMode] = useState(true);

  const [deviceHour, setDeviceHour] = useState(new Date().getHours());
  const [currentDateString] = useState(() => {
    const d = new Date();
    return d.toISOString().split('T')[0];
  });

  const [selectedHistoryDate, setSelectedHistoryDate] = useState(new Date().toISOString().split('T')[0]);
  
  const [isCalendarModalVisible, setIsCalendarModalVisible] = useState(false);
  const [calendarViewDate, setCalendarViewDate] = useState(new Date());

  const sellScrollRef = useRef<ScrollView>(null);

  const [products, setProducts] = useState<any[]>([]);
  const [categories, setCategories] = useState<string[]>(['Alimentos', 'Accesorios']);
  const [selectedCategoryFilter, setSelectedCategoryFilter] = useState<string>('TODAS');
  const [isCategoryDropdownOpen, setIsCategoryDropdownOpen] = useState(false);

  const [selectedSortOption, setSelectedSortOption] = useState<string>('Por Defecto');
  const [isSortDropdownOpen, setIsSortDropdownOpen] = useState(false);

  const [dailyHistoryLogs, setDailyHistoryLogs] = useState<{ [date: string]: any[] }>({});
  const [totalMoneyEarned, setTotalMoneyEarned] = useState(0);

  const [expandedProductId, setExpandedProductId] = useState<string | null>(null);
  const [activeCandle, setActiveCandle] = useState<any | null>(null);

  const particleAnim = useRef(new Animated.Value(0)).current;

  // Animaciones para botones flotantes (+ y $)
  const scaleAddBtn = useRef(new Animated.Value(1)).current;
  const scaleSellBtn = useRef(new Animated.Value(1)).current;

  const triggerButtonAnimation = (animValue: Animated.Value) => {
    Animated.sequence([
      Animated.timing(animValue, { toValue: 1.25, duration: 100, useNativeDriver: true }),
      Animated.timing(animValue, { toValue: 1, duration: 100, useNativeDriver: true }),
    ]).start();
  };

  useEffect(() => {
    const animationLoop = Animated.loop(
      Animated.timing(particleAnim, {
        toValue: 1,
        duration: 3000,
        useNativeDriver: true,
      })
    );
    animationLoop.start();
    return () => animationLoop.stop();
  }, [particleAnim]);

  // Cargar datos persistidos al iniciar
  useEffect(() => {
    async function loadPersistedData() {
      try {
        const storedOnboarding = await AsyncStorage.getItem(STORAGE_KEY_ONBOARDING);
        const storedUsername = await AsyncStorage.getItem(STORAGE_KEY_USERNAME);
        const storedTheme = await AsyncStorage.getItem(STORAGE_KEY_THEME);
        const storedProducts = await AsyncStorage.getItem(STORAGE_KEY_PRODUCTS);
        const storedCategories = await AsyncStorage.getItem(STORAGE_KEY_CATEGORIES);
        const storedNotes = await AsyncStorage.getItem(STORAGE_KEY_NOTES);
        const storedHistory = await AsyncStorage.getItem(STORAGE_KEY_HISTORY);
        const storedMoney = await AsyncStorage.getItem(STORAGE_KEY_MONEY);
        const storedImg = await AsyncStorage.getItem(STORAGE_KEY_PROFILE_IMG);
        const storedHours = await AsyncStorage.getItem(STORAGE_KEY_HOURS);

        if (storedOnboarding === 'true') setHasCompletedOnboarding(true);
        if (storedUsername) {
          setSetupUsername(storedUsername);
          setProfileName(storedUsername);
        }
        if (storedTheme !== null) {
          const isDark = storedTheme === 'true';
          setSetupThemeDark(isDark);
          setIsDarkMode(isDark);
        }
        if (storedProducts) setProducts(JSON.parse(storedProducts));
        if (storedCategories) setCategories(JSON.parse(storedCategories));
        if (storedNotes) setNotesList(JSON.parse(storedNotes));
        if (storedHistory) setDailyHistoryLogs(JSON.parse(storedHistory));
        if (storedMoney) setTotalMoneyEarned(parseFloat(storedMoney) || 0);
        if (storedImg) setProfileImage(storedImg);
        if (storedHours) setHoursOfDay(JSON.parse(storedHours));
      } catch (e) {
        console.log('[SEEDIUS] Error cargando datos:', e);
      } finally {
        setTimeout(() => {
          setIsLoading(false);
        }, 1200);
      }
    }
    loadPersistedData();
  }, []);

  const saveDataToStorage = async (key: string, value: any) => {
    try {
      const jsonValue = typeof value === 'string' ? value : JSON.stringify(value);
      await AsyncStorage.setItem(key, jsonValue);
    } catch (e) {
      console.log('[SEEDIUS] Error guardando en almacenamiento:', e);
    }
  };

  // Función para restablecer / borrar todo el historial desde los ajustes
  const handleResetAppHistory = async () => {
    try {
      await AsyncStorage.multiRemove([
        STORAGE_KEY_ONBOARDING,
        STORAGE_KEY_USERNAME,
        STORAGE_KEY_PRODUCTS,
        STORAGE_KEY_CATEGORIES,
        STORAGE_KEY_NOTES,
        STORAGE_KEY_HISTORY,
        STORAGE_KEY_MONEY,
        STORAGE_KEY_PROFILE_IMG,
        STORAGE_KEY_HOURS
      ]);

      setProducts([]);
      setCategories(['Alimentos', 'Accesorios']);
      setNotesList([]);
      setDailyHistoryLogs({});
      setTotalMoneyEarned(0);
      setProfileImage(null);
      setHoursOfDay(
        Array.from({ length: 24 }, (_, index) => ({
          hour: index,
          sellCount: 0,
          sellMoney: 0,
        }))
      );
      setHasCompletedOnboarding(false);
      setOnboardingStep(1);
      Haptics.notificationAsync(Haptics.NotificationFeedbackType.Success);
      showCustomToast("🧹 Historial y datos restablecidos por completo.");
    } catch (e) {
      console.log('[SEEDIUS] Error al restablecer:', e);
    }
  };

  const [toastMessage, setToastMessage] = useState<string | null>(null);
  const [toastAction, setToastAction] = useState<(() => void) | null>(null);
  const toastOpacity = useRef(new Animated.Value(0)).current;

  const [isAddModalVisible, setIsAddModalVisible] = useState(false);
  const [newProductName, setNewProductName] = useState('');
  const [newProductPrice, setNewProductPrice] = useState('');
  const [newProductCategory, setNewProductCategory] = useState('');
  const [newProductStock, setNewProductStock] = useState('');

  const [isEditModalVisible, setIsEditModalVisible] = useState(false);
  const [editingProduct, setEditingProduct] = useState<any>(null);

  const [isActionModalVisible, setIsActionModalVisible] = useState(false);
  const [actionTargetProduct, setActionTargetProduct] = useState<any>(null);

  const [isAdvancedDeleteModalVisible, setIsAdvancedDeleteModalVisible] = useState(false);
  const [isResetConfirmModalVisible, setIsResetConfirmModalVisible] = useState(false);

  const [isQtyModalVisible, setIsQtyModalVisible] = useState(false);
  const [qtyTargetProduct, setQtyTargetProduct] = useState<any>(null);
  const [inputQuantity, setInputQuantity] = useState('');

  const [notesList, setNotesList] = useState<any[]>([]);
  const [isAddNoteModalVisible, setIsAddNoteModalVisible] = useState(false);
  const [isEditNoteModalVisible, setIsEditNoteModalVisible] = useState(false);
  const [isDeleteNoteModalVisible, setIsDeleteNoteModalVisible] = useState(false);
  const [currentNote, setCurrentNote] = useState<any>(null);
  const [newNoteTitle, setNewNoteTitle] = useState('');
  const [newNoteContent, setNewNoteContent] = useState('');

  const [profileName, setProfileName] = useState('Administrador Comercial');
  const [profileImage, setProfileImage] = useState<string | null>(null);
  const [isEditProfileModal, setIsEditProfileModal] = useState(false);

  const [hoursOfDay, setHoursOfDay] = useState(
    Array.from({ length: 24 }, (_, index) => ({
      hour: index,
      sellCount: 0,
      sellMoney: 0,
    }))
  );

  const mainTabsSequence = ['home', 'stock', 'notes', 'profile'];

  // Manejo inteligente del botón "Atrás" físico/gestual de Android
  useEffect(() => {
    const backAction = () => {
      if (isCategoryDropdownOpen) {
        setIsCategoryDropdownOpen(false);
        return true;
      }
      if (isSortDropdownOpen) {
        setIsSortDropdownOpen(false);
        return true;
      }

      if (isAddModalVisible) { setIsAddModalVisible(false); return true; }
      if (isEditModalVisible) { setIsEditModalVisible(false); return true; }
      if (isActionModalVisible) { setIsActionModalVisible(false); return true; }
      if (isAdvancedDeleteModalVisible) { setIsAdvancedDeleteModalVisible(false); return true; }
      if (isResetConfirmModalVisible) { setIsResetConfirmModalVisible(false); return true; }
      if (isQtyModalVisible) { setIsQtyModalVisible(false); return true; }
      if (isAddNoteModalVisible) { setIsAddNoteModalVisible(false); return true; }
      if (isEditNoteModalVisible) { setIsEditNoteModalVisible(false); return true; }
      if (isDeleteNoteModalVisible) { setIsDeleteNoteModalVisible(false); return true; }
      if (isEditProfileModal) { setIsEditProfileModal(false); return true; }
      if (isCalendarModalVisible) { setIsCalendarModalVisible(false); return true; }
      if (isTourActive) { setIsTourActive(false); return true; }

      if (currentTab !== 'home') {
        setCurrentTab('home');
        return true;
      }

      return false;
    };

    const backHandler = BackHandler.addEventListener('hardwareBackPress', backAction);
    return () => backHandler.remove();
  }, [
    isCategoryDropdownOpen, isSortDropdownOpen, isAddModalVisible, isEditModalVisible,
    isActionModalVisible, isAdvancedDeleteModalVisible, isResetConfirmModalVisible, isQtyModalVisible, 
    isAddNoteModalVisible, isEditNoteModalVisible, isDeleteNoteModalVisible, isEditProfileModal, 
    isCalendarModalVisible, isTourActive, currentTab
  ]);

  const handleSwipeGesture = (direction: 'left' | 'right') => {
    if (
      !hasCompletedOnboarding || isTourActive ||
      isAddModalVisible || isEditModalVisible || isActionModalVisible || 
      isAdvancedDeleteModalVisible || isResetConfirmModalVisible || isQtyModalVisible || isAddNoteModalVisible || 
      isEditNoteModalVisible || isDeleteNoteModalVisible || isEditProfileModal ||
      isCalendarModalVisible || currentTab === 'sell' || currentTab === 'lowStock' || currentTab === 'fullHistory'
    ) {
      return;
    }

    const currentIndex = mainTabsSequence.indexOf(currentTab);
    if (currentIndex === -1) return;

    if (direction === 'left' && currentIndex < mainTabsSequence.length - 1) {
      Haptics.selectionAsync();
      setCurrentTab(mainTabsSequence[currentIndex + 1] as any);
    } else if (direction === 'right' && currentIndex > 0) {
      Haptics.selectionAsync();
      setCurrentTab(mainTabsSequence[currentIndex - 1] as any);
    }
  };

  const staticPanResponder = useRef(
    PanResponder.create({
      onStartShouldSetPanResponder: () => false,
      onMoveShouldSetPanResponder: (_, gestureState) => {
        return Math.abs(gestureState.dx) > 30 && Math.abs(gestureState.dy) < 20;
      },
      onPanResponderRelease: (_, gestureState) => {
        if (gestureState.dx > 40) handleSwipeGesture('right');
        else if (gestureState.dx < -40) handleSwipeGesture('left');
      },
    })
  ).current;

  useEffect(() => {
    const timeSyncInterval = setInterval(() => {
      setDeviceHour(new Date().getHours());
    }, 30000);
    return () => clearInterval(timeSyncInterval);
  }, []);

  useEffect(() => {
    if (!isLoading && hasCompletedOnboarding && currentTab === 'home') {
      setTimeout(() => {
        const targetX = Math.max(0, (deviceHour - 2) * 40);
        sellScrollRef.current?.scrollTo({ x: targetX, animated: true });
      }, 300);
    }
  }, [isLoading, hasCompletedOnboarding, currentTab]);

  const triggerSplashScreenAndStart = async (shouldRunTour: boolean) => {
    if (!setupUsername.trim()) return;
    const cleanName = setupUsername.trim();
    setProfileName(cleanName);
    setIsDarkMode(setupThemeDark);
    setHasCompletedOnboarding(true);

    await saveDataToStorage(STORAGE_KEY_ONBOARDING, 'true');
    await saveDataToStorage(STORAGE_KEY_USERNAME, cleanName);
    await saveDataToStorage(STORAGE_KEY_THEME, setupThemeDark ? 'true' : 'false');

    if (shouldRunTour) {
      setTimeout(() => {
        setTourStepIndex(0);
        setIsTourActive(true);
        setCurrentTab('home');
      }, 300);
    }
  };

  const handleTourNext = () => {
    Haptics.selectionAsync();
    if (tourStepIndex < tourSteps.length - 1) {
      const nextIdx = tourStepIndex + 1;
      setTourStepIndex(nextIdx);
      setCurrentTab(tourSteps[nextIdx].tab as any);
    } else {
      setIsTourActive(false);
      showCustomToast("🚀 ¡Tour finalizado! Ya puedes operar SEEDIUS.");
    }
  };

  const handleTourSkip = () => {
    Haptics.selectionAsync();
    setIsTourActive(false);
    showCustomToast("✨ Introducción omitida con éxito.");
  };

  const showCustomToast = (msg: string, actionCallback?: () => void) => {
    setToastMessage(msg);
    setToastAction(() => actionCallback || null);
    Animated.timing(toastOpacity, { toValue: 1, duration: 300, useNativeDriver: true }).start();

    setTimeout(() => {
      Animated.timing(toastOpacity, { toValue: 0, duration: 300, useNativeDriver: true }).start(() => {
        setToastMessage(null);
        setToastAction(null);
      });
    }, 4000);
  };

  const getMaxMetricValue = () => {
    let max = 30; 
    hoursOfDay.forEach(h => { if (h.sellCount > max) max = h.sellCount; });
    return Math.ceil(max / 15) * 15;
  };

  const dynamicMax = getMaxMetricValue();
  const axisValues = [dynamicMax, Math.round(dynamicMax * 0.75), Math.round(dynamicMax * 0.5), Math.round(dynamicMax * 0.25), 0];

  const pickImage = async () => {
    const permissionResult = await ImagePicker.requestMediaLibraryPermissionsAsync();
    if (!permissionResult.granted) return;

    const result = await ImagePicker.launchImageLibraryAsync({
      mediaTypes: ImagePicker.MediaTypeOptions.Images,
      allowsEditing: true,
      aspect: [1, 1],
      quality: 0.8,
    });

    if (!result.canceled && result.assets && result.assets.length > 0) {
      const uri = result.assets[0].uri;
      setProfileImage(uri);
      await saveDataToStorage(STORAGE_KEY_PROFILE_IMG, uri);
      Haptics.notificationAsync(Haptics.NotificationFeedbackType.Success);
    }
  };

  const handleAddProduct = async () => {
    if (!newProductName || !newProductPrice) return;
    const finalCategory = newProductCategory.trim() || 'General';
    const initialStock = parseInt(newProductStock) || 0;

    let updatedCats = categories;
    if (finalCategory !== 'General' && !categories.includes(finalCategory)) {
      updatedCats = [...categories, finalCategory];
      setCategories(updatedCats);
      await saveDataToStorage(STORAGE_KEY_CATEGORIES, updatedCats);
    }

    const newProd = {
      id: Date.now().toString(),
      name: newProductName,
      price: parseFloat(newProductPrice) || 0,
      stock: initialStock,
      initialStockRef: initialStock,
      category: finalCategory,
      salesHistory: Array.from({ length: 24 }, (_, i) => ({ 
        hour: i, 
        count: 0, 
        money: 0, 
        minutes: { q1: 0, q2: 0, q3: 0, q4: 0 } 
      }))
    };

    const updatedProducts = [...products, newProd];
    setProducts(updatedProducts);
    await saveDataToStorage(STORAGE_KEY_PRODUCTS, updatedProducts);

    const currentMinute = new Date().getMinutes();
    const newLogItem = {
      id: Date.now().toString(),
      text: `Añadiste "${newProductName}" al estoc (${initialStock} un.)`,
      type: 'Estoc',
      time: `${deviceHour}:${String(currentMinute).padStart(2, '0')} hrs`
    };

    setDailyHistoryLogs(prev => {
      const todayLogs = prev[currentDateString] || [];
      const newHistory = { ...prev, [currentDateString]: [newLogItem, ...todayLogs] };
      saveDataToStorage(STORAGE_KEY_HISTORY, newHistory);
      return newHistory;
    });

    setNewProductName('');
    setNewProductPrice('');
    setNewProductCategory('');
    setNewProductStock('');
    setIsAddModalVisible(false);
    Haptics.notificationAsync(Haptics.NotificationFeedbackType.Success);
  };

  const handleUpdateProduct = async () => {
    if (!editingProduct.name || !editingProduct.price) return;
    const finalCat = editingProduct.category.trim() || 'General';
    let updatedCats = categories;
    if (finalCat !== 'General' && !categories.includes(finalCat)) {
      updatedCats = [...categories, finalCat];
      setCategories(updatedCats);
      await saveDataToStorage(STORAGE_KEY_CATEGORIES, updatedCats);
    }

    const newStock = parseInt(editingProduct.stock) || 0;
    const updatedRef = newStock > editingProduct.initialStockRef ? newStock : editingProduct.initialStockRef;

    const updated = { ...editingProduct, category: finalCat, stock: newStock, initialStockRef: updatedRef };
    const updatedProducts = products.map(p => p.id === updated.id ? updated : p);
    setProducts(updatedProducts);
    await saveDataToStorage(STORAGE_KEY_PRODUCTS, updatedProducts);

    const currentMinute = new Date().getMinutes();
    const newLogItem = {
      id: Date.now().toString(),
      text: `Actualizaste "${updated.name}" (Stock: ${newStock} un.)`,
      type: 'Estoc',
      time: `${deviceHour}:${String(currentMinute).padStart(2, '0')} hrs`
    };

    setDailyHistoryLogs(prev => {
      const todayLogs = prev[currentDateString] || [];
      const newHistory = { ...prev, [currentDateString]: [newLogItem, ...todayLogs] };
      saveDataToStorage(STORAGE_KEY_HISTORY, newHistory);
      return newHistory;
    });

    setIsEditModalVisible(false);
    setEditingProduct(null);
    Haptics.notificationAsync(Haptics.NotificationFeedbackType.Success);
  };

  const executeAdvancedDelete = async (eraseAnalytics: boolean) => {
    if (!actionTargetProduct) return;

    const updatedProducts = products.filter(p => p.id !== actionTargetProduct.id);
    setProducts(updatedProducts);
    await saveDataToStorage(STORAGE_KEY_PRODUCTS, updatedProducts);

    if (eraseAnalytics) {
      const resetHours = Array.from({ length: 24 }, (_, index) => ({ hour: index, sellCount: 0, sellMoney: 0 }));
      setHoursOfDay(resetHours);
      await saveDataToStorage(STORAGE_KEY_HOURS, resetHours);
      setTotalMoneyEarned(0);
      await saveDataToStorage(STORAGE_KEY_MONEY, 0);
    }

    const currentMinute = new Date().getMinutes();
    const newLogItem = {
      id: Date.now().toString(),
      text: eraseAnalytics ? `Eliminaste "${actionTargetProduct.name}" y purgaste analíticas` : `Eliminaste "${actionTargetProduct.name}" (manteniendo métricas)`,
      type: 'Estoc',
      time: `${deviceHour}:${String(currentMinute).padStart(2, '0')} hrs`
    };

    setDailyHistoryLogs(prev => {
      const todayLogs = prev[currentDateString] || [];
      const newHistory = { ...prev, [currentDateString]: [newLogItem, ...todayLogs] };
      saveDataToStorage(STORAGE_KEY_HISTORY, newHistory);
      return newHistory;
    });

    setIsAdvancedDeleteModalVisible(false);
    setActionTargetProduct(null);
    setExpandedProductId(null);
    Haptics.notificationAsync(Haptics.NotificationFeedbackType.Warning);
    showCustomToast(eraseAnalytics ? "🗑️ Producto y analíticas purgados." : "🛡️ Producto eliminado, métricas intactas.");
  };

  const confirmQuantityMovement = async () => {
    const qty = parseInt(inputQuantity);
    if (isNaN(qty) || qty <= 0) return;

    if (qtyTargetProduct.stock < qty) {
      Haptics.notificationAsync(Haptics.NotificationFeedbackType.Error);
      showCustomToast("¡No tienes esa cantidad en el estoc!");
      return;
    }

    const moneyTotal = qty * qtyTargetProduct.price;
    const remainingStock = qtyTargetProduct.stock - qty;
    const currentMinute = new Date().getMinutes();

    let minuteKey = 'q1';
    if (currentMinute >= 15 && currentMinute < 30) minuteKey = 'q2';
    else if (currentMinute >= 30 && currentMinute < 45) minuteKey = 'q3';
    else if (currentMinute >= 45) minuteKey = 'q4';

    const updatedProducts = products.map(p => {
      if (p.id === qtyTargetProduct.id) {
        const updatedHistory = p.salesHistory ? p.salesHistory.map((h: any) => {
          if (h.hour === deviceHour) {
            const currentMins = h.minutes || { q1: 0, q2: 0, q3: 0, q4: 0 };
            return { 
              ...h, 
              count: h.count + qty, 
              money: h.money + moneyTotal,
              minutes: { ...currentMins, [minuteKey]: currentMins[minuteKey] + qty }
            };
          }
          return h;
        }) : [];
        return { ...p, stock: remainingStock, salesHistory: updatedHistory };
      }
      return p;
    });

    setProducts(updatedProducts);
    await saveDataToStorage(STORAGE_KEY_PRODUCTS, updatedProducts);

    const newTotalMoney = totalMoneyEarned + moneyTotal;
    setTotalMoneyEarned(newTotalMoney);
    await saveDataToStorage(STORAGE_KEY_MONEY, newTotalMoney);

    const newHours = hoursOfDay.map(h => {
      if (h.hour === deviceHour) {
        return { ...h, sellCount: h.sellCount + qty, sellMoney: h.sellMoney + moneyTotal };
      }
      return h;
    });
    setHoursOfDay(newHours);
    await saveDataToStorage(STORAGE_KEY_HOURS, newHours);

    if (activeCandle && activeCandle.hour === deviceHour) {
      const targetProd = updatedProducts.find(p => p.id === qtyTargetProduct.id);
      const existingHistory = targetProd?.salesHistory?.find((h: any) => h.hour === deviceHour);
      const updatedMins = existingHistory?.minutes ? { ...existingHistory.minutes, [minuteKey]: existingHistory.minutes[minuteKey] + qty } : { q1: 0, q2: 0, q3: 0, q4: qty };

      const cHourFormatted = `${String(deviceHour).padStart(2, '0')}:00`;
      const nextHFormatted = `${String((deviceHour + 1) % 24).padStart(2, '0')}:00`;
      const q1Time = `${String(deviceHour).padStart(2, '0')}:15`;
      const q2Time = `${String(deviceHour).padStart(2, '0')}:30`;
      const q3Time = `${String(deviceHour).padStart(2, '0')}:45`;

      setActiveCandle({
        hour: deviceHour,
        count: (activeCandle.count || 0) + qty,
        money: (activeCandle.money || 0) + moneyTotal,
        minutes: [
          { time: `${cHourFormatted} - ${q1Time}`, count: updatedMins.q1 || 0, money: (updatedMins.q1 || 0) * qtyTargetProduct.price },
          { time: `${q1Time} - ${q2Time}`, count: updatedMins.q2 || 0, money: (updatedMins.q2 || 0) * qtyTargetProduct.price },
          { time: `${q2Time} - ${q3Time}`, count: updatedMins.q3 || 0, money: (updatedMins.q3 || 0) * qtyTargetProduct.price },
          { time: `${q3Time} - ${nextHFormatted}`, count: updatedMins.q4 || 0, money: (updatedMins.q4 || 0) * qtyTargetProduct.price },
        ]
      });
    }

    const newLogItem = {
      id: Date.now().toString(),
      text: `Vendiste ${qty}x ${qtyTargetProduct.name} ($${moneyTotal.toFixed(2)})`,
      type: 'Venta',
      time: `${deviceHour}:${String(currentMinute).padStart(2, '0')} hrs`
    };

    setDailyHistoryLogs(prev => {
      const todayLogs = prev[currentDateString] || [];
      const newHistory = { ...prev, [currentDateString]: [newLogItem, ...todayLogs] };
      saveDataToStorage(STORAGE_KEY_HISTORY, newHistory);
      return newHistory;
    });

    const threshold = qtyTargetProduct.initialStockRef * 0.05;
    if (remainingStock === 0) {
      Haptics.notificationAsync(Haptics.NotificationFeedbackType.Warning);
      showCustomToast(`🔴 ¡Se agotó "${qtyTargetProduct.name}" (0 un.)!`, () => setCurrentTab('lowStock'));
    } else if (remainingStock <= threshold) {
      Haptics.notificationAsync(Haptics.NotificationFeedbackType.Notification);
      showCustomToast(`🟡 ¡Atención! "${qtyTargetProduct.name}" está casi acabado (${remainingStock} un.)`, () => setCurrentTab('lowStock'));
